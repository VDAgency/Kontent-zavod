# Скопировать в .env и заполнить. Файл .env в git не попадает — см. .gitignore.

# --- n8n Public API (нужен MCP-серверу n8n-mcp) ---------------------------
# Пока VPS не поднят, обе переменные можно оставить пустыми:
# n8n-mcp тогда работает в режиме документации и валидации, без доступа к инстансу.
N8N_API_URL=
N8N_API_KEY=

# ⚠️ В community-редакции ключ n8n API даёт полный доступ ко всем workflow,
# credentials и логам выполнения. Обращаться с ним как с паролем от сервера:
# не коммитить, не пересылать, при утечке — удалить в Settings → n8n API
# и выпустить новый.

# --- Context7 (только для локального CLI, см. docs/TOOLS.md) --------------
# CONTEXT7_API_KEY=

# --- GitHub (только для локального CLI, см. docs/TOOLS.md) ----------------
# GITHUB_PERSONAL_ACCESS_TOKEN=
